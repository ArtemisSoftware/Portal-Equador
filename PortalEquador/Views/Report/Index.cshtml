@{
    ViewData["Title"] = "Index";
}




<div class="text-center">
    <h1 class="display-4">Relatórios</h1>
    <br />
    <br />
    <div class="row">

        <div class="row">
            <div class="col-sm-6">
                <div class="card">
                    <div class="card-body">
                        <h3 class="card-title">Idade</h3>
                        <p class="card-text">Relatório de idades</p>

                        <!-- Loader -->
                        <div id="loader" style="display: none;" class="text-center mb-3">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p>Gerando relatório...</p>
                        </div>


                        <div class="d-grid gap-2 col-6 mx-auto">
                            <a asp-controller="Report" asp-action="ExportAgeReportInExcel" class="btn btn-primary">Download</a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                
                    

            </div>
        </div>

    </div>


</div>

@section Scripts {
    <script>
        document.getElementById('downloadForm').addEventListener('submit', function () {
            document.getElementById('loader').style.display = 'block';
        });
    </script>
}