@model PortalEquador.Domain.Report.ViewModels.Uniforms.UniformsReportFormViewModel

@{
    ViewData["Title"] = "Create";
}

<br />
<h1>Relatório de fardas</h1>
<hr />

<div class="d-flex justify-content-center mt-5">
    <div style="width: 40%;">
        <form asp-action="UniformReportForm">
            
            <div class="mb-3">
                <label asp-for="ContractId" class="form-label"></label>
                <select asp-for="ContractId" class="form-select" asp-items="Model.Contracts"></select>
            </div>
            <br />

            <div class="mb-3">
                <label asp-for="UniformId" class="form-label"></label>
                <select asp-for="UniformId" class="form-select" asp-items="Model.Uniforms"></select>
            </div>
            <br />

            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="AddUniformReturn" /> @Html.DisplayNameFor(model => model.AddUniformReturn)
                </label>
            </div>
            <br />

            @if (Model.Error != null)
            {
                <br />
                <div class="text-center">
                    <div class="alert alert-warning" role="alert">
                        @Html.DisplayFor(modelItem => Model.Error)
                    </div>
                </div>
                <br />
            }

            <div class="text-center">
                <input type="submit" value="Gerar Relatório" class="btn btn-primary btn-block" />
            </div>
        </form>
    </div>
</div>



@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
