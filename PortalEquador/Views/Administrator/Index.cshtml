@using Microsoft.AspNetCore.Identity
@using PortalEquador.Data.Generic
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@using PortalEquador.Util
@model IEnumerable<PortalEquador.Domain.Administrator.ViewModels.AdministratorViewModel>

@{
    ViewData["Title"] = "Home Page";
}

<h1>Administradores</h1>


<p>
    <a asp-action="Create" class="btn btn-success"><i class="fas fa-plus"></i> Criar Novo Administrador</a>
</p>
<br />
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.UserName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Role)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Active)
            </th>

            <th> </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.UserName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Email)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Role)
                </td>
                <td class="align-middle">
                    @if (@item.Active)
                    {
                        <span class="badge bg-success">Ativo</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Inativo</span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" asp-route-groupId="@ViewBag.groupId" asp-route-groupName="@ViewBag.groupName" class="btn btn-warning"><i class="fas fa-pencil-alt" title="Editar"></i></a>
                    <a asp-action="Details" asp-route-id="@item.Id" asp-route-groupId="@ViewBag.groupId" asp-route-groupName="@ViewBag.groupName" class="btn btn-info"><i class="fas fa-eye" title="Detalhe"></i></a>
                    @if (@item.Active)
                    {
                        <button data-id="@item.Id" class="btn btn-danger deleteBtn" type="button">Desativar</button>
                    }
                    else
                    {
                        <button data-id="@item.Id" class="btn btn-success allocateBtn" type="button">Ativar</button>
                    }

                </td>
                <td></td>
            </tr>
        }
    </tbody>
</table>

<form id="deactivateItem" asp-action="DeactivateItem" asp-route-groupId="@ViewBag.groupId" asp-route-groupName="@ViewBag.groupName">
    <input type="hidden" id="groupDeactiviationItemId" name="Id" />
</form>

<form id="activateItem" asp-action="ActivateItem" asp-route-groupId="@ViewBag.groupId" asp-route-groupName="@ViewBag.groupName">
    <input type="hidden" id="groupActiviationItemId" name="Id" />
</form>

<br />
<a asp-controller="Group" asp-action="Index" class="btn btn-dark"> <i class="fas fa-chevron-left" title="Regressar aos grupos "></i> Regressar aos grupos</a>

@section Scripts {
    <script>
        $(function () {
            var table = $('.table').DataTable({
                order: [] // keep server-side order
            });

            // Delegated event binding for delete button
            $('.table').on('click', '.deleteBtn', function () {
                swal({
                    title: "Desativar item",
                    text: "Tem a certeza que pretende desativar o registo?",
                    icon: "warning",
                    buttons: true,
                    dangerMode: true
                }).then((confirm) => {
                    if (confirm) {
                        var id = $(this).data("id");
                        $('#groupDeactiviationItemId').val(id);
                        $('#deactivateItem').submit();
                    }
                });
            });

            // Delegated event binding for activate button
            $('.table').on('click', '.allocateBtn', function () {
                swal({
                    title: "Ativar item",
                    text: "Tem a certeza que pretende ativar o registo?",
                    icon: "warning",
                    buttons: true,
                    dangerMode: true
                }).then((confirm) => {
                    if (confirm) {
                        var id = $(this).data("id");
                        $('#groupActiviationItemId').val(id);
                        $('#activateItem').submit();
                    }
                });
            });
        });
    </script>
}