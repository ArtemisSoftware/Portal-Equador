@model PortalEquador.Domain.Administrator.ViewModels.AdministratorResetPasswordViewModel

@{
    ViewData["Title"] = "Create";
}
<br />
<h1>Alterar Palavra-chave</h1>
<h3>Admin: @Model.UserName</h3>
<div>
<hr />
<br />

    <div class="row">
        <div class="col-md-4">
        <form asp-action="ResetPassword">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="UserName" />
                <input type="hidden" asp-for="Email" />

            <dl class="row">
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Email)
                </dt>
                <dd class="col-sm-10">
                        @Html.DisplayFor(model => model.Email)
                </dd>
            </dl>

            <div class="form-group">
                    <div class="alert alert-primary" role="alert">
                        A nova palavra-chave:  <h4 class="alert-heading">@Model.Password</h4>
                    </div>
            </div>
                

        <br />
        <div>
            <a asp-action="Index" class="btn btn-dark">Regressar ao index</a> &nbsp;
            <input type="submit" value="Guardar Alterações" class="btn btn-warning" />
        </div>
    </form>
        </div>
    </div>

