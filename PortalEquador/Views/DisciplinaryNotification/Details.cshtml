﻿@using PortalEquador.Util.Constants
@model PortalEquador.Domain.DisciplinaryNotification.ViewModels.DisciplinaryNotificationViewModel

@{
    ViewData["Title"] = "Details";
}

<h1>Detalhes</h1>
<h4>Para: @ViewBag.username</h4>

<hr />

<div class="row">

    <div class="col-md-5">

        <dl class="row">

            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.Date)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Date)
            </dd>

            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.Notification)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Notification.Description)
            </dd>

            <dt class="col-sm-12">
                <br />
            </dt>

            @if(Model.Notification.Id == GroupTypesConstants.ItemFromGroup.DisciplinaryNotification.ALCOOL)
            {
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Bulletin)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Bulletin)
                </dd>

                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.AlcoolTestResult)
                </dt>
                <dd class="col-sm-8">

                    @if (Model.isAlcoolTestPositive())
                    {
                        <span class="badge bg-danger">@Html.DisplayFor(model => model.AlcoolTestResult.Description)</span>
                    }
                    else
                    {
                        <span class="badge bg-success">@Html.DisplayFor(model => model.AlcoolTestResult.Description)</span>
                    }
                </dd>

                <dt class="col-sm-12">
                    <br />
                </dt>
            }

            @if (Model.Notification.Id == GroupTypesConstants.ItemFromGroup.DisciplinaryNotification.ACCIDENT)
            {
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Local)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Local)
                </dd>

                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.AccidentLevel)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.AccidentLevel.Description)
                </dd>

                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Decision)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Decision)
                </dd>

                <dt class="col-sm-12">
                    <br />
                </dt>
            }





            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.Observation)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Observation)
            </dd>


            <dt class="col-sm-12">
                <br />
            </dt>

            @if (@Model.DateModified != null)
            {
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.DateModified)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.DateModified)
                </dd>
            }
            else
            {
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.DateCreated)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.DateCreated)
                </dd>
            }


            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.Editor)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Editor)
            </dd>
        </dl>

    </div>

    <div class="col-md-7">
        @if (Model.PicturePath != null)
        {
            <div class="row">

                <div class="col-sm-6">
                    <div class="card">
                        <img id="frame" src="@Url.Content(@Model.PicturePath)" class="card-img-top">
                        <div class="card-body">

                            <button class="btn btn-info" onclick="window.open('@Url.Content(@Model.PicturePath)', '_blank')">
                                <i class="fa-solid fa-up-right-and-down-left-from-center"></i>
                            </button>
                        </div>
                    </div>

                </div>
            </div>

        }
        else
        {
            <div class="col-sm-6">
                <h4>Nenhum documento associado</h4>
            </div>
        }
    </div>

</div>