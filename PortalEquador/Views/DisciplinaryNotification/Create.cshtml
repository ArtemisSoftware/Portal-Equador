﻿@using PortalEquador.Util.Constants
@model PortalEquador.Domain.DisciplinaryNotification.ViewModels.DisciplinaryNotificationCreateViewModel


@{
    ViewData["Title"] = "Create";
}


<br />
<h1>Criar Notificação Disciplinar</h1>
<h4>Para: @Model.FullName</h4>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="PersonaInformationId" />
            <input type="hidden" asp-for="FullName" />

            <div class="form-group">
                <label asp-for="Date" class="control-label"></label>
                <input asp-for="Date" class="form-control" />
                <span asp-validation-for="Date" class="text-danger"></span>
            </div>
            <br />

            <div class="form-group" id="Notification">
                <label asp-for="NotificationId" class="control-label"></label>
                <select asp-for="NotificationId" class="form-select" asp-items="Model.Notifications" onChange="NotificationSelect()" id="SelectNotification"></select>
            </div>
            <br />

            <div id="Accident">
                <div class="mb-3">
                    <label asp-for="Local" class="control-label"></label>
                    <input asp-for="Local" class="form-control" />
                    <span asp-validation-for="Local" class="text-danger"></span>
                </div>
                <div class="form-group" id="AccidentLevel">
                    <label asp-for="AccidentLevelId" class="control-label"></label>
                    <select asp-for="AccidentLevelId" class="form-select" asp-items="Model.AccidentLevels"></select>
                </div>
                <br />
                <div class="mb-3">
                    <label asp-for="Decision" class="control-label"></label>
                    <textarea asp-for="Decision" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Decision" class="text-danger"></span>
                </div>
                <br />
            </div>
            

 

            <div id="Alcool">
                <div class="form-group">
                    <label asp-for="Bulletin" class="control-label"></label>
                    <input asp-for="Bulletin" class="form-control" />
                    <span asp-validation-for="Bulletin" class="text-danger"></span>
                </div>

                <br />

                <div class="form-group" id="AlcoolTestResult">
                    <label asp-for="AlcoolTestResultId" class="control-label"></label>
                    <select asp-for="AlcoolTestResultId" class="form-select" asp-items="Model.AlcoolTestResults"></select>
                </div>
                <br />
            </div>

            

            <div class="mb-3">
                <label asp-for="Observation" class="control-label"></label>
                <textarea asp-for="Observation" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Observation" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ImageFile" class="form-label"></label>
                <input asp-for="ImageFile" accept="image/*" onchange="preview()" class="form-control" type="file" />
                <span asp-validation-for="ImageFile" class="text-danger"></span>
            </div>

            <br />
            <br />
            <div class="form-group">
                <a asp-action="Index" asp-route-identifier="@Model.PersonaInformationId" asp-route-fullName="@Model.FullName" class="btn btn-dark">Regressar ao index</a> &nbsp;
                <input type="submit" value="Criar registo" class="btn btn-primary" />
            </div>
        </form>
    </div>


    <div class="col-md-8">
        <label for="Image" class="form-label">Pré-visualização</label>
        <br />
        <img id="frame" src="" class="img-fluid" />
    </div>
</div>



@section Scripts {
    <script>
        function preview() {
            frame.src = URL.createObjectURL(event.target.files[0]);
        }
        function clearImage() {
            document.getElementById('formFile').value = null;
            frame.src = "";
        }
        function NotificationSelect() {

            var response = document.getElementById('SelectNotification').value;
            var alcool = document.getElementById('Alcool');
           var accident = document.getElementById('Accident');

            const alcoolNotificationId = '@GroupTypesConstants.ItemFromGroup.DisciplinaryNotification.ALCOOL';
            const accidentNotificationId = '@GroupTypesConstants.ItemFromGroup.DisciplinaryNotification.ACCIDENT';

            accident.hidden = true
            alcool.hidden = true
           
            if (response == alcoolNotificationId) {
                alcool.hidden = false
            }
            if (response == accidentNotificationId) {
                accident.hidden = false
            }
        }
        window.onload = function () {
            NotificationSelect()
        };
    </script>
}

