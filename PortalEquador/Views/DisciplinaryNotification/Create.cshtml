@model PortalEquador.Domain.DisciplinaryNotification.ViewModels.DisciplinaryNotificationCreateViewModel


@{
    ViewData["Title"] = "Create";
}


<br />
<h1>Criar Notificação Disciplinar</h1>
<h4>Para: @Model.FullName</h4>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="PersonaInformationId" />
            <input type="hidden" asp-for="FullName" />

            <div class="form-group">
                <label asp-for="Date" class="control-label"></label>
                <input asp-for="Date" class="form-control" />
                <span asp-validation-for="Date" class="text-danger"></span>
            </div>

            <div class="form-group" id="Notification">
                <label asp-for="NotificationId" class="control-label"></label>
                <select asp-for="NotificationId" class="form-select" asp-items="Model.Notifications"></select>
            </div>
            <br />

            <div class="mb-3">
                <label asp-for="Local" class="control-label"></label>
                <textarea asp-for="Local" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Local" class="text-danger"></span>
            </div>

            <div class="form-group" id="AccidentLevel">
                <label asp-for="AccidentLevelId" class="control-label"></label>
                <select asp-for="AccidentLevelId" class="form-select" asp-items="Model.AccidentLevels"></select>
            </div>
            <br />

            <div class="mb-3">
                <label asp-for="Observation" class="control-label"></label>
                <textarea asp-for="Observation" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Observation" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ImageFile" class="form-label"></label>
                <input asp-for="ImageFile" accept="image/*" onchange="preview()" class="form-control" type="file" />
                <span asp-validation-for="ImageFile" class="text-danger"></span>
            </div>

            <br />
            <br />
            <div class="form-group">
                <a asp-action="Index" asp-route-identifier="@Model.PersonaInformationId" asp-route-fullName="@Model.FullName" class="btn btn-dark">Regressar ao index</a> &nbsp;
                <input type="submit" value="Criar registo" class="btn btn-primary" />
            </div>
        </form>
    </div>


    <div class="col-md-8">
        <label for="Image" class="form-label">Pré-visualização</label>
        <br />
        <img id="frame" src="" class="img-fluid" />
    </div>
</div>



@section Scripts {
    <script>
        function preview() {
            frame.src = URL.createObjectURL(event.target.files[0]);
        }
        function clearImage() {
            document.getElementById('formFile').value = null;
            frame.src = "";
        }
    </script>
}

