@model PortalEquador.Domain.Accident.ViewModels.AccidentViewModel

@{
    ViewData["Title"] = "Create";
}
<br />
<h1>Criar Novo Acidente</h1>
<h4>Para: @Model.FullName</h4>

<hr />
<br />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" enctype="multipart/form-data" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="PersonaInformationId" />
            <input type="hidden" asp-for="FullName" />

            <div class="form-group col-sm-6">
                <label asp-for="Number" class="control-label"></label>
                <input asp-for="Number" class="form-control" min="1" />
                <span asp-validation-for="Number" class="text-danger"></span>
            </div>
            <br />

            <dl class="row">

                <dd class="col-sm-6">
                    <div class="form-group">
                        <label asp-for="Date" class="control-label"></label>
                        <input asp-for="Date" class="form-control" />
                        <span asp-validation-for="Date" class="text-danger"></span>
                    </div>
                </dd>
                <dd class="col-sm-6">
                    <div class="form-group">
                        <label asp-for="Time" class="control-label"></label>
                        <input asp-for="Time" class="form-control" />
                        <span asp-validation-for="Time" class="text-danger"></span>
                    </div>
                </dd>
            </dl>
            <br />

            <h6>Viatura</h6>
            <hr />


            <div class="form-group ">
                <label asp-for="LicencePlate" class="control-label"></label>
                <dl class="row">
                    <dt class="col-sm-5">
                        <div class="form-group">
                            <select asp-for="VehicleId" class="form-select" asp-items="Model.Vehicles" id="vehicleDropdown"></select>
                        </div>
                    </dt>
                </dl>
            </div>
            <div class="form-group">
                <label asp-for="Model" class="control-label"></label>
                <input asp-for="Model" class="form-control" id="vehicleModel" disabled />
            </div>
            <br />

            <div class="form-group">
                <label asp-for="ContractId" class="control-label"></label>
                <select asp-for="ContractId" class="form-select" asp-items="Model.Contracts"></select>
            </div>
            <br />

            <dl class="row">

                <dd class="col-sm-5">
                    <div class="form-group">
                        <label asp-for="CityId" class="control-label"></label>
                        <select asp-for="CityId" class="form-select" asp-items="Model.Cities"></select>
                    </div>
                </dd>
                <dd class="col-sm-7">
                    <div class="form-group">
                        <label asp-for="Address" class="control-label"></label>
                        <input asp-for="Address" class="form-control" />
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>
                </dd>
            </dl>
            <br />


            <h6>Causas</h6>
            <hr />

            @for (int index = 0; index < Model.Causes.Count; index++)
            {
                <div class="form-check">
                    <input asp-for="@Model.SelectedCauses[index]" class="form-check-input" type="checkbox" id="@Model.Causes[index].Id" />
                    <label asp-for="@Model.SelectedCauses[index]" class="form-check-label">
                        @Html.DisplayFor(modelItem => @Model.Causes[index].Description)
                    </label>
                </div>
            }
            <br />

            <div class="form-group">
                <label asp-for="EstimatedValueId" class="control-label"></label>
                <select asp-for="EstimatedValueId" class="form-select" asp-items="Model.EstimatedValues"></select>
            </div>
            <br />

            <div class="form-group col-sm-4">
                <label asp-for="HumanDamage" class="control-label"></label>
                <input asp-for="HumanDamage" class="form-control" min="0" />
                <span asp-validation-for="HumanDamage" class="text-danger"></span>
            </div>
            <br />

            <div class="form-group  col-sm-4">
                <label asp-for="LevelId" class="control-label"></label>
                <select asp-for="LevelId" class="form-select" asp-items="Model.Levels"></select>
            </div>
            <br />

            <div class="form-group">
                <label asp-for="PdfFile" class="form-label"></label>
                <input asp-for="PdfFile" accept="application/pdf" class="form-control" type="file" />
                <span asp-validation-for="PdfFile" class="text-danger"></span>
            </div>
            <br />

            @if (Model.Error != null)
            {
                <div class="form-group">
                    <div class="alert alert-danger" role="alert">
                        <span asp-validation-for="Error"></span>
                    </div>
                </div>
            }
            <br />
            <br />
            <div class="form-group">
                <a asp-action="Index" asp-route-identifier="@Model.PersonaInformationId" asp-route-fullName="@Model.FullName" class="btn btn-dark">Regressar ao index</a> &nbsp;
                <input type="submit" value="Criar registo" class="btn btn-primary" />
            </div>
        </form>
    </div>

</div>


@section Scripts {

    <!-- Include jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <!-- Include Select2 library -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <script>

        $(document).ready(function () {
            // Apply Select2 to the dropdown
            $('#vehicleDropdown').select2({
                placeholder: "Selecione uma viatura",
                allowClear: true,
                theme: "bootstrap-5"
            });

            // Attach the change event listener after initializing Select2
            $('#vehicleDropdown').on('change', function () {
                var vehicleId = $(this).val();
                handleVehicle(vehicleId);
            });

            // Handle page load logic
            var initialVehicleId = $('#vehicleDropdown').val();
            handleVehicle(initialVehicleId);
        });
    </script>

    <script>

        function handleVehicle(vehicleId) {
            if (vehicleId) {
                fetch(`/Accident/GetVehicleDetails?vehicleId=${vehicleId}`)
                    .then(response => response.json())
                    .then(data => {
                        document.getElementById("vehicleModel").value = data.model;
                        document.getElementById("vehicleContract").value = data.contract;
                    })
                    .catch(error => console.error('Error fetching vehicle details:', error));
            } else {
                document.getElementById("vehicleModel").value = '';
                document.getElementById("vehicleContract").value = '';
            }
        }

        function handleVehicleChange() {
            var vehicleDropdown = document.getElementById("vehicleDropdown");
            vehicleDropdown.addEventListener("change", function () {
                var vehicleId = this.value;
                handleVehicle(vehicleId)
            });
        }

        // Call the method on page load
        window.onload = function () {

            handleVehicleChange();
            var vehicleDropdown = document.getElementById("vehicleDropdown");
            var vehicleId = vehicleDropdown.value;
            handleVehicle(vehicleId);
        };
    </script>

}
