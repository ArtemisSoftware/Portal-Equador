@model PortalEquador.Domain.Uniforms.ViewModels.WorkerUniformCreateViewModel

@{
    ViewData["Title"] = "Create";
}

<br />
<h1>Adicionar Novo Fardamento</h1>
<h4>Para: @Model.FullName</h4>

<hr />
<br />
<div class="row">
    <div class="col-md-5">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="PersonaInformationId" />
            <input type="hidden" asp-for="FullName" />

            <div class="form-group">
                <label asp-for="Date" class="control-label"></label>
                <input asp-for="Date" class="form-control" />
                <span asp-validation-for="Date" class="text-danger"></span>
            </div>
            <br />

            <div class="form-group ">
                <label asp-for="UniformId" class="control-label"></label>
                <dl class="row">
                    <dt class="col-sm-6">
                        <div class="form-group">
                            <select asp-for="UniformId" class="form-select" asp-items="Model.Uniforms" id="uniformDropdown"></select>
                        </div>
                    </dt>
                </dl>
            </div>
            <br />

            <div class="form-group">
                <label asp-for="Quantity" class="control-label"></label>
                <input asp-for="Quantity" class="form-control" min="1" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>
            <br />

            <div class="form-group" id="SizeDiv">
                <label asp-for="Size" class="control-label"></label>
                <input asp-for="Size" class="form-control" min="36" />
                <span asp-validation-for="Size" class="text-danger"></span>
            </div>
           
            <div class="form-group" id="LabelSizeDiv">
                <label asp-for="LabelSizeId" class="control-label"></label>
                <select asp-for="LabelSizeId" class="form-control form-select" asp-items="@Model.LabelSizes"></select>
            </div>
            
            <br />

            <div class="form-group">
                <label asp-for="Observation" class="control-label"></label>
                <textarea asp-for="Observation" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Observation" class="text-danger"></span>
            </div>

            @if (Model.Error != null)
            {
                <div class="form-group">
                    <div class="alert alert-danger" role="alert">
                        <span asp-validation-for="Error"></span>
                    </div>
                </div>
            }
            <br />
            <br />
            <div class="form-group">
                <a asp-action="Index" asp-route-identifier="@Model.PersonaInformationId" asp-route-fullName="@Model.FullName" class="btn btn-dark">Regressar ao index</a> &nbsp;
                <input type="submit" value="Criar registo" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

@section Scripts {

    <!-- Include jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <!-- Include Select2 library -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <script>
        $(document).ready(function () {
            // Apply Select2 to the dropdown
            $('#uniformDropdown').select2({
                placeholder: "Selecione uma farda",
                allowClear: true,
                theme: "bootstrap-5"
            });

            // Attach the change event listener after initializing Select2
            $('#uniformDropdown').on('change', function () {
                var uniformId = $(this).val();
                handleUniform(uniformId);
            });

            // Handle page load logic
            var initialUniformId = $('#uniformDropdown').val();
            handleUniform(initialUniformId);
        });
    </script>

    <script>

        function handleUniform(uniformId) {
            if (uniformId) {
                fetch(`/WorkerUniform/GetSizeDetails?uniformId=${uniformId}`)
                    .then(response => response.json())
                    .then(data => {
                        
                        var SizeDiv = document.getElementById('SizeDiv');
                        var LabelSizeDiv = document.getElementById('LabelSizeDiv');

                        if (data.isSizeNumeric) {
                            SizeDiv.hidden = true;
                            LabelSizeDiv.hidden = false;
                        }
                        else {
                            SizeDiv.hidden = false;
                            LabelSizeDiv.hidden = true;
                        }
                    })
                    .catch(error => console.error('Error fetching size details:', error));
            } else {
                SizeDiv.hidden = true;
                LabelSizeDiv.hidden = true;
            }
        }

        function handleUniformChange() {
            var uniformDropdown = document.getElementById("uniformDropdown");
            uniformDropdown.addEventListener("change", function () {
                var uniformId = this.value;
                handleUniform(uniformId)
            });
        }

        // Call the method on page load
        window.onload = function () {

           var SizeDiv = document.getElementById('SizeDiv');
           var LabelSizeDiv = document.getElementById('LabelSizeDiv');
            SizeDiv.hidden = true;
            LabelSizeDiv.hidden = true;

            handleUniformChange();
            var uniformDropdown = document.getElementById("uniformDropdown");
            var uniformId = uniformDropdown.value;
            handleUniform(uniformId);
            
        };
    </script>

}