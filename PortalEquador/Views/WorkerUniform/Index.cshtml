@model IEnumerable<PortalEquador.Domain.Uniforms.ViewModels.WorkerUniformViewModel>
@using Microsoft.AspNetCore.Identity
@using PortalEquador.Data.Generic
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@using PortalEquador.Util

@{
    ViewData["Title"] = "Index";
}

<div class="row align-items-center">
    <div class="col-md-10">
        <h1>@ViewBag.username</h1>
        <h3>Fardas</h3>
        <p>
            <a asp-controller="WorkerUniform" asp-action="Create" asp-route-identifier="@ViewBag.identifier" asp-route-fullName="@ViewBag.username" class="btn btn-success"><i class="fas fa-plus"></i> Criar Novo Registo</a>
        </p>
    </div>
    <div class="col-md-2 text-right">
        <a asp-controller="Contract" asp-action="Dashboard" asp-route-identifier="@ViewBag.identifier" class="btn btn-success"> <i class="fas fa-info-circle" title="Regressar ao Painel"></i> Regressar ao Painel</a>
    </div>
</div>
<hr />
<br />

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Date)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ReturnDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Uniform)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Quantity)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Size)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="align-middle">
                    @Html.DisplayFor(modelItem => item.Date)
                </td>
                <td class="align-middle">
                    @Html.DisplayFor(modelItem => item.ReturnDate)
                </td>
                <td class="align-middle">
                    @Html.DisplayFor(modelItem => item.Uniform.Description)
                </td>
                <td class="align-middle">
                    @Html.DisplayFor(modelItem => item.Quantity)
                </td>
                <td class="align-middle">
                    @Html.DisplayFor(modelItem => item.Size)
                </td>
                <td>
                    
                    @if (@item.ReturnDate == null)
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" asp-route-identifier="@ViewBag.identifier" asp-route-fullName="@ViewBag.username" class="btn btn-warning"><i class="fas fa-pencil-alt" title="Editar"></i></a>

                        <a asp-action="ReturnDate" asp-route-id="@item.Id" asp-route-identifier="@ViewBag.identifier" asp-route-fullName="@ViewBag.username" class="btn btn-success">
                           Registar devolução
                         </a>
                    }

                    @if (User.IsInRole(Roles.Administrator) || User.IsInRole(Roles.DataManager))
                    {
                         @if (@item.ReturnDate != null)
                        {
                            <a asp-action="Edit" 
                                    asp-route-id="@item.Id" 
                                    asp-route-identifier="@ViewBag.identifier" 
                                    asp-route-fullName="@ViewBag.username" class="btn btn-warning"><i class="fas fa-pencil-alt" title="Editar"></i>
                             </a>
                        }

                        <button data-id="@item.Id" class="btn btn-danger deleteBtn" type="button" data-identifier="@ViewBag.identifier" data-username="@ViewBag.username"><i class="fas fa-trash-alt" title="Editar"></i></button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<form id="deleteWorkerUniform" asp-action="DeleteWorkerUniform">
    <input type="hidden" id="workerUniformId" name="Id" />
    <input type="hidden" id="identifier" name="identifier" />
    <input type="hidden" id="username" name="username" />
</form>


@section Scripts {
    <script>
        $(function () {

            $('.table').DataTable();

            $('.deleteBtn').click(function (e) {
                swal({
                    title: "Eliminar farda",
                    text: "Tem a certeza que pretende eliminar a farda?",
                    icon: "warning",
                    buttons: true,
                    dangerMode: true
                }).then((confirm) => {
                    if (confirm) {
                        var btn = $(this);
                        var id = btn.data("id");
                        var identifier = btn.data("identifier");
                        var username = btn.data("username");
                        $('#workerUniformId').val(id);
                        $('#identifier').val(identifier);
                        $('#username').val(username);
                        $('#deleteWorkerUniform').submit();

                    }
                });
            });
        });

    </script>
}
