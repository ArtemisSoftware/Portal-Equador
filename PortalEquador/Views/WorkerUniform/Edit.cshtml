@model PortalEquador.Domain.Uniforms.ViewModels.WorkerUniformEditViewModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Editar Farda</h1>
<h4>Para: @Model.FullName</h4>
<hr />
<br />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="PersonaInformationId" />
            <input type="hidden" asp-for="FullName" />
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="DateCreated" />
            <input type="hidden" asp-for="DateModified" />


            <dl class="row">
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Uniform)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Uniform.Description)
                </dd>
            </dl>

            <div class="form-group">
                <label asp-for="Date" class="control-label"></label>
                <input asp-for="Date" class="form-control" />
                <span asp-validation-for="Date" class="text-danger"></span>
            </div>
            <br />

             @if (Model.ReturnDate != null){
                <div class="form-group">
                    <label asp-for="ReturnDate" class="control-label"></label>
                    <input asp-for="ReturnDate" class="form-control" />
                    <span asp-validation-for="ReturnDate" class="text-danger"></span>
                </div>
                <br />
            }
            
            <div class="form-group">
                <label asp-for="Quantity" class="control-label"></label>
                <input asp-for="Quantity" class="form-control" min="1" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>
            <br />

            @if (Model.Uniform.isSizeNumeric)
            {
                <div class="form-group">
                    <label asp-for="Size" class="control-label"></label>
                    <input asp-for="Size" class="form-control" min="1" />
                    <span asp-validation-for="Size" class="text-danger"></span>
                </div>
            
            } else
            {
                <div class="form-group">
                    <label asp-for="LabelSizeId" class="control-label"></label>
                    <select asp-for="LabelSizeId" class="form-select" asp-items="Model.LabelSizes"></select>
                </div>
               
            }

            <br />

            <div class="mb-3">
                <label asp-for="Observation" class="control-label"></label>
                <textarea asp-for="Observation" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Observation" class="text-danger"></span>
            </div>
            

            @if (Model.Error != null)
            {
                <div class="form-group">
                    <div class="alert alert-danger" role="alert">
                        <span asp-validation-for="Error"></span>
                    </div>
                </div>
            }

            <br />
            <div>
                <a asp-action="Index" asp-route-identifier="@ViewBag.identifier" asp-route-fullName="@ViewBag.username" class="btn btn-dark">Regressar ao index</a> &nbsp;
                <input type="submit" value="Guardar Alterações" class="btn btn-warning" />
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>

        document.addEventListener('DOMContentLoaded', function () {
            const dateInput = document.querySelector('[name="Date"]');
            const returnInput = document.querySelector('[name="ReturnDate"]');

            // initialize min value
            if (dateInput && returnInput) {
                returnInput.min = dateInput.value;

                dateInput.addEventListener('change', function () {
                    const selectedDate = dateInput.value;
                    returnInput.min = selectedDate;

                    // If return date is before new min, clear it
                    if (returnInput.value && returnInput.value < selectedDate) {
                        returnInput.value = selectedDate;
                    }
                });
            }
        }); 
    </script>
}
