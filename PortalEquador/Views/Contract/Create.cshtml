@model PortalEquador.Domain.Contract.ViewModels.ContractCreate__ViewModel

@{
    ViewData["Title"] = "Create";
}
<br />
<h1>Criar Novo Contrato</h1>
<h4>Para: @Model.FullName</h4>
<hr />
<br />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="PersonaInformationId" />

            <div class="form-group">
                <label asp-for="ContractId" class="control-label"></label>
                <select asp-for="ContractId" class="form-select" asp-items="Model.Contracts"></select>
            </div>
            <br />

            <div class="form-group">
                <label asp-for="DateOfContract" class="control-label"></label>
                <input asp-for="DateOfContract" class="form-control" />
                <span asp-validation-for="DateOfContract" class="text-danger"></span>
            </div>

            <br />

            <div class="mb-3">
                <label asp-for="Observation" class="control-label"></label>
                <textarea asp-for="Observation" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Observation" class="text-danger"></span>
            </div>

            <br />

            @if (Model.Error != null)
            {
                <div class="form-group">
                    <div class="alert alert-danger" role="alert">
                        <span asp-validation-for="Error"></span>
                    </div>
                </div>
            }
            <br />
            <br />
            <div class="form-group">
                <a asp-action="Index" asp-route-identifier="@Model.PersonaInformationId" class="btn btn-dark">Regressar ao index</a> &nbsp;
                <input type="submit" value="Criar registo" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
