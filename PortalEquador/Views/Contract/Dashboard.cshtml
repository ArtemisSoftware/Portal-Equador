@using Microsoft.AspNetCore.Identity
@using PortalEquador.Data.Generic
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@using PortalEquador.Util
@model PortalEquador.Domain.Contract.ViewModels.ContractDashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<h1>Painel</h1>

<div>
    <br />

    <div class="row align-items-center">
        <div class="col-md-10">
            <div class="row align-items-center">
                <div class="col-auto">
                    <img src="@Url.Content(@Model.ProfileImagePath)" alt="" style="width: 90px; height: 90px" class="rounded-circle" />
                </div>
                <div class="col-auto">
                    <h4>@Model.FullName</h4>
                </div>
            </div>
        </div>
        <div class="col-md-2 text-right">
            <a asp-controller="Contract" asp-action="Index" class="btn btn-dark"> Regressar aos Funcionários</a>
        </div>
    </div>
    <hr />


    <div class="row">

        <div class="col-sm-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Contrato</h5>
                    <p class="card-text">Descrição do estado da contratação </p>

                    @switch (Model.ContractStateDescription())
                    {
                        case PortalEquador.Domain.Contract.ContractState.Unassigned:
                            <span class="badge bg-secondary">@PortalEquador.Util.Constants.StringConstants.ContractStatus.UNASSIGNED </span>
                            break;

                        case PortalEquador.Domain.Contract.ContractState.Contracted:
                            <span class="badge bg-success">@Model.Contract.Description </span>
                            break;

                        case PortalEquador.Domain.Contract.ContractState.Fired:
                            <span class="badge bg-danger">@Model.Contract.Description</span>
                            break;

                        default:
                            <span class="badge bg-primary">@Model.Contract.Description</span>
                            break;
                    }

                    <p class="card-text"> </p>

                    @switch (Model.ContractStateDescription())
                    {
                        case PortalEquador.Domain.Contract.ContractState.Unassigned:

                            <a asp-controller="Contract"
                               asp-action="Create"
                               asp-route-identifier="@Model.PersonaInformationId" asp-route-origin="cv" asp-route-fullName="@Model.FullName" class="btn btn-success">Contratar</a>

                            break;

                        case PortalEquador.Domain.Contract.ContractState.Contracted:

                            <a asp-controller="Contract"
                               asp-action="Create"
                               asp-route-identifier="@Model.PersonaInformationId" asp-route-origin="cv" asp-route-fullName="@Model.FullName" class="btn btn-success">Alterar Contrato</a>

                            <a asp-controller="Contract"
                               asp-action="Resign"
                               asp-route-identifier="@Model.PersonaInformationId" asp-route-origin="cv" asp-route-fullName="@Model.FullName" class="btn btn-warning">Dispensar</a>

                            break;

                        default:

                            <a asp-controller="Contract"
                               asp-action="Create"
                               asp-route-identifier="@Model.PersonaInformationId" asp-route-origin="cv" asp-route-fullName="@Model.FullName" class="btn btn-success">Re-Contratar</a>

                            break;
                    }

                    @if (Model.TotalContracts > 0)
                    {
                        <a asp-controller="Contract" 
                            asp-action="History"
                           asp-route-identifier="@Model.PersonaInformationId" asp-route-fullName="@Model.FullName" class="btn btn-warning"><i class="fas fa-list" title="Index"></i></a>
                    }

                </div>
            </div>
        </div>

        <div class="col-sm-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Curriculo</h5>
                    <p class="card-text">Curriculo associado</p>

                    <a asp-controller="Curriculum" asp-action="Dashboard" asp-route-identifier="@Model.PersonaInformationId" asp-route-fullName="@Model.FullName" class="btn btn-success">
                        <i class="fa-solid fa-arrow-up-right-from-square"></i>
                    </a>

                </div>
            </div>
        </div>

    </div>

    <br />

    <div class="row">

        <div class="col-sm-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Exames</h5>
                    <span class="badge bg-success">@Model.TotalExams Registo(s)</span>
                    <p class="card-text">Formulário para o registo de exames.</p>
                    @if (Model.TotalExams != 0)
                    {
                        <a asp-controller="MedicalExam" asp-action="Index" asp-route-identifier="@Model.PersonaInformationId" asp-route-fullName="@Model.FullName" class="btn btn-warning"><i class="fas fa-list" title="Index"></i></a>
                    }
                    <a asp-controller="MedicalExam" asp-action="Create" asp-route-identifier="@Model.PersonaInformationId" asp-route-fullName="@Model.FullName" class="btn btn-success"><i class="fas fa-plus" title="Criar"></i></a>
                </div>
            </div>
        </div>

        <div class="col-sm-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Formações</h5>
                    <span class="badge bg-success">@Model.TotalTrainning Registo(s)</span>
                    <p class="card-text">Formulário para o registo de formações.</p>
                    @if (Model.TotalTrainning != 0)
                    {
                        <a asp-controller="Trainning" asp-action="Index" asp-route-identifier="@Model.PersonaInformationId" asp-route-fullName="@Model.FullName" class="btn btn-warning"><i class="fas fa-list" title="Index"></i></a>
                    }
                    <a asp-controller="Trainning" asp-action="Create" asp-route-identifier="@Model.PersonaInformationId" asp-route-fullName="@Model.FullName" class="btn btn-success"><i class="fas fa-plus" title="Criar"></i></a>
                </div>
            </div>
        </div>

        <div class="col-sm-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Notificações Disciplinares</h5>
                    <span class="badge bg-success">@Model.TotalDisciplinaryNotification Registo(s)</span>
                    <p class="card-text">Formulário para o registo de notificações disciplinares.</p>
                    @if (Model.TotalDisciplinaryNotification != 0)
                    {
                        <a asp-controller="DisciplinaryNotification" asp-action="Index" asp-route-identifier="@Model.PersonaInformationId" asp-route-fullName="@Model.FullName" class="btn btn-warning"><i class="fas fa-list" title="Index"></i></a>
                    }
                    <a asp-controller="DisciplinaryNotification" asp-action="Create" asp-route-identifier="@Model.PersonaInformationId" asp-route-fullName="@Model.FullName" class="btn btn-success"><i class="fas fa-plus" title="Criar"></i></a>
                </div>
            </div>
        </div>
        
    </div>

     @if (User.IsInRole(Roles.Administrator) || User.IsInRole(Roles.DataManager))
     {
        <div class="row">

            <div class="col-sm-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Acidentes</h5>
                        <span class="badge bg-success">@Model.TotalAccidents Registo(s)</span>
                        <p class="card-text">Formulário para o registo de acidentes.</p>
                        @if (Model.TotalAccidents != 0)
                        {
                            <a asp-controller="Accident" asp-action="Index" asp-route-identifier="@Model.PersonaInformationId" asp-route-fullName="@Model.FullName" class="btn btn-warning"><i class="fas fa-list" title="Index"></i></a>
                        }
                        <a asp-controller="Accident" asp-action="Create" asp-route-identifier="@Model.PersonaInformationId" asp-route-fullName="@Model.FullName" class="btn btn-success"><i class="fas fa-plus" title="Criar"></i></a>
                    </div>
                </div>
            </div>

        </div>
        <br />
    }

</div>