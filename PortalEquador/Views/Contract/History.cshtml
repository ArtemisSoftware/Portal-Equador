@model PortalEquador.Domain.Contract.ViewModels.ContractHistoryViewModel

@{
    ViewData["Title"] = "Index";
}

<div class="row align-items-center">
    <div class="col-md-10">
        <h1>@ViewBag.username</h1>
        <h3>Contratos</h3>
     </div>
    <div class="col-md-2 text-right">
        <a asp-controller="Curriculum" asp-action="Dashboard" asp-route-identifier="@ViewBag.identifier" class="btn btn-success"> <i class="fas fa-info-circle" title="Regressar ao Painel"></i> Regressar ao Painel</a>
    </div>
</div>
<hr />
<br />


<h3>Estado Atual</h3>
<br />
@if (Model.Current.Count > 0)
{
    


<table class="table">
    <thead>
        <tr>
            <th>
                    @Html.DisplayNameFor(model => model.Current[0].DateOfContract)
            </th>
            <th>
                    @Html.DisplayNameFor(model => model.Current[0].ContractState)
            </th>
                <th>
                    @Html.DisplayNameFor(model => model.Current[0].Contract)
                </th>
            <th>
                    @Html.DisplayNameFor(model => model.Current[0].ResignationReasons)
            </th>
            <th>
                    @Html.DisplayNameFor(model => model.Current[0].Observation)
            </th>
            
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Current)
        {
            <tr>
                <td class="align-middle">
                        @Html.DisplayFor(modelItem => item.DateOfContract)
                </td>
                <td class="align-middle">
                    @switch (item.ContractStateDescription())
                    {
                        case PortalEquador.Domain.Contract.ContractState.Unassigned:
                            <span class="badge bg-secondary">@PortalEquador.Util.Constants.StringConstants.ContractStatus.UNASSIGNED </span>
                            break;

                        case PortalEquador.Domain.Contract.ContractState.Contracted:
                            <span class="badge bg-success">@Html.DisplayFor(modelItem => item.ContractState.Description) </span>
                            break;

                        case PortalEquador.Domain.Contract.ContractState.Fired:
                            <span class="badge bg-danger">@Html.DisplayFor(modelItem =>item.ContractState.Description)</span>
                            break;

                        default:
                            <span class="badge bg-primary">@Html.DisplayFor(modelItem => item.ContractState.Description)</span>
                            break;
                    }
                </td>

                    <td class="align-middle">
                        @Html.DisplayFor(modelItem => item.Contract.Description)
                    </td>
                
                <td class="align-middle">
                    @Html.DisplayFor(modelItem => item.ResignationReasons.Description)
                </td>
                <td class="align-middle">
                    @Html.DisplayFor(modelItem => item.Observation)
                </td>
                
                <td>
                    
                </td>
            </tr>
        }
    </tbody>
</table>

}


@if (Model.History.Count > 0)
{

    <br />
    <br />


    <h3>Histórico</h3>
    <br />

    <table class="table">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.History[0].DateOfContract)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.History[0].ContractState)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.History[0].Contract)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.History[0].ResignationReasons)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.History[0].Observation)
                </th>

                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.History)
            {
                <tr>
                    <td class="align-middle">
                        @Html.DisplayFor(modelItem => item.DateOfContract)
                    </td>
                    <td class="align-middle">
                        @switch (item.ContractStateDescription())
                        {
                            case PortalEquador.Domain.Contract.ContractState.Unassigned:
                                <span class="badge bg-secondary">@PortalEquador.Util.Constants.StringConstants.ContractStatus.UNASSIGNED </span>
                                break;

                            case PortalEquador.Domain.Contract.ContractState.Contracted:
                                <span class="badge bg-success">@Html.DisplayFor(modelItem => item.ContractState.Description) </span>
                                break;

                            case PortalEquador.Domain.Contract.ContractState.Fired:
                                <span class="badge bg-danger">@Html.DisplayFor(modelItem => item.ContractState.Description)</span>
                                break;

                            default:
                                <span class="badge bg-primary">@Html.DisplayFor(modelItem => item.ContractState.Description)</span>
                                break;
                        }
                    </td>
                    <td class="align-middle">
                        @Html.DisplayFor(modelItem => item.Contract.Description)
                    </td>
                    <td class="align-middle">
                        @Html.DisplayFor(modelItem => item.ResignationReasons.Description)
                    </td>
                    <td class="align-middle">
                        @Html.DisplayFor(modelItem => item.Observation)
                    </td>

                    <td>
                    </td>
                </tr>
            }
        </tbody>
    </table>

}

@section Scripts {
    <script>
        $(function () {
            $('.table').DataTable();
        });

    </script>
}
