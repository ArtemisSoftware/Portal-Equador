@model IEnumerable<PortalEquador.Domain.Trainning.ViewModels.TrainningViewModel>

@{
    ViewData["Title"] = "Index";
}

<div class="row align-items-center">
    <div class="col-md-10">
        <h1>@ViewBag.username</h1>
        <h3>Formações</h3>
        <p>
            <a asp-controller="Trainning" asp-action="Create" asp-route-identifier="@ViewBag.identifier" asp-route-fullName="@ViewBag.username" class="btn btn-success"><i class="fas fa-plus"></i> Criar Novo Registo</a>
        </p>
    </div>
    <div class="col-md-2 text-right">
        <a asp-controller="Contract" asp-action="Dashboard" asp-route-identifier="@ViewBag.identifier" class="btn btn-success"> <i class="fas fa-info-circle" title="Regressar ao Painel"></i> Regressar ao Painel</a>
    </div>
</div>
<hr />
<br />
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Date)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Trainning)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PicturePath)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="align-middle">
                    @Html.DisplayFor(modelItem => item.Date)
                </td>
                <td class="align-middle">
                    @Html.DisplayFor(modelItem => item.Trainning.Description)
                </td>
                <td class="align-middle">
                    @if (item.PicturePath != null)
                    {
                        <a class="link-offset-1" href="@Url.Content(@item.PicturePath)" target="_blank">
                            Documento
                        </a>
                    }

                </td>

                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" asp-route-identifier="@item.Id" asp-route-fullName="@ViewBag.username" class="btn btn-info"><i class="fas fa-eye" title="Editar"></i></a>
                    <button data-id="@item.Id" class="btn btn-danger deleteBtn" type="button" data-identifier="@ViewBag.identifier" data-username="@ViewBag.username"><i class="fas fa-trash-alt" title="Eliminar"></i></button>

                </td>
            </tr>
        }
    </tbody>
</table>


<form id="deleteTrainning" asp-action="DeleteTrainning">
    <input type="hidden" id="id" name="Id" />
    <input type="hidden" id="identifier" name="identifier" />
    <input type="hidden" id="username" name="username" />
</form>


@section Scripts {
    <script>
        $(function () {

            $('.table').DataTable();

            $('.deleteBtn').click(function (e) {
                swal({
                    title: "Eliminar formação",
                    text: "Tem a certeza que pretende eliminar a formação?",
                    icon: "warning",
                    buttons: true,
                    dangerMode: true
                }).then((confirm) => {
                    if (confirm) {
                        var btn = $(this);
                        var id = btn.data("id");
                        var identifier = btn.data("identifier");
                        var username = btn.data("username");
                        $('#id').val(id);
                        $('#identifier').val(identifier);
                        $('#username').val(username);
                        $('#deleteTrainning').submit();

                    }
                });
            });
        });

    </script>
}
