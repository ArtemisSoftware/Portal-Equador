@model IEnumerable<PortalEquador.Domain.MechanicalWorkshop.Workshop.ViewModels.WorkshopDetailViewModel>

@{
    ViewData["Title"] = "Index";
}
<div class="row align-items-center">
    <div class="col-md-10">
        <h1>Oficinas </h1>
        <h4>Index </h4>
    </div>
    <div class="col-md-2 text-right">
        <a asp-controller="Workshop" asp-action="Dashboard" class="btn btn-dark"> <i class="fas fa-chevron-left" title="Regressar aos painel "></i>Regressar aos painel</a>
    </div>
</div>
<hr />
<p>
    <a asp-action="Create" class="btn btn-success"><i class="fas fa-plus"></i> Criar oficina</a>
</p>
<br />
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th></th>
            <th>
                @Html.DisplayNameFor(model => model.Lanes)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Mechanics)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="align-middle">
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td class="align-middle">
                    @if (@item.Active)
                    {
                        <span class="badge bg-success">Ativo</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Inativo</span>
                    }
                </td>
                <td class="align-middle">
                    @Html.DisplayFor(modelItem => item.Lanes.Count)
                </td>
                <td class="align-middle">
                    @Html.DisplayFor(modelItem => item.Mechanics.Count)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id"  class="btn btn-warning"><i class="fas fa-pencil-alt" title="Editar"></i></a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info"><i class="fas fa-eye" title="Detalhe"></i></a>
                    @if (@item.Active)
                    {
                        <button data-id="@item.Id" class="btn btn-danger deleteBtn" type="button">Desativar</button>
                    }
                    else
                    {
                        <button data-id="@item.Id" class="btn btn-success allocateBtn" type="button">Ativar</button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>



<form id="deactivateWorkshop" asp-action="DeactivateWorkshop" >
    <input type="hidden" id="deactivateid" name="Id" />
</form>

<form id="activateWorkshop" asp-action="ActivateWorkshop">
    <input type="hidden" id="activateid" name="Id" />
</form>



@section Scripts {
    <script>
        $(function () {

            $('.table').DataTable();

                // Delegated event binding for delete button
                $('.table').on('click', '.deleteBtn', function () {
                    swal({
                        title: "Desativar item",
                        text: "Tem a certeza que pretende desativar o registo?",
                        icon: "warning",
                        buttons: true,
                        dangerMode: true
                    }).then((confirm) => {
                        if (confirm) {
                            var id = $(this).data("id");
                            $('#deactivateid').val(id);
                            $('#deactivateWorkshop').submit();
                        }
                    });
                });

                // Delegated event binding for activate button
                $('.table').on('click', '.allocateBtn', function () {
                    swal({
                        title: "Ativar item",
                        text: "Tem a certeza que pretende ativar o registo?",
                        icon: "warning",
                        buttons: true,
                        dangerMode: true
                    }).then((confirm) => {
                        if (confirm) {
                            var id = $(this).data("id");
                            $('#activateid').val(id);
                            $('#activateWorkshop').submit();
                        }
                    });
                });
        });

    </script>
}
