@model PortalEquador.Domain.MechanicalWorkshop.Workshop.ViewModels.WorkshopCreateViewModel

@{
    ViewData["Title"] = "Create";
}
<br />
<h1>Criar Nova oficina</h1>
<hr />
<br />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <br />

            <div class="form-group col-sm-4">
                <label asp-for="NumberOfLanes" class="control-label"></label>
                <input asp-for="NumberOfLanes" class="form-control" min="1" />
                <span asp-validation-for="NumberOfLanes" class="text-danger"></span>
            </div>
            <br />

            @if (Model.Error != null)
            {
                <div class="form-group">
                    <div class="alert alert-danger" role="alert">
                        <span asp-validation-for="Error"></span>
                    </div>
                </div>
            }

            <br />
            <br />
            <div class="form-group">
                <a asp-action="Index" class="btn btn-dark">Regressar ao index</a> &nbsp;
                <input type="submit" value="Criar registo" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
