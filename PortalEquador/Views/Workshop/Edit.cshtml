@model PortalEquador.Domain.MechanicalWorkshop.Workshop.ViewModels.WorkshopDetailViewModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Editar</h1>

<h4>Item</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Active" />
            <input type="hidden" asp-for="DateCreated" />

            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <br />

            <br />
            <br />
            <div>
                <a asp-action="Dashboard" class="btn btn-dark">Regressar ao index</a> &nbsp;
                <input type="submit" value="Guardar Alterações" class="btn btn-warning" />
            </div>
        </form>
    </div>
</div>