@using Microsoft.AspNetCore.Identity
@using PortalEquador.Data.Generic
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@using PortalEquador.Util
@model IEnumerable<PortalEquador.Domain.MechanicalWorkshop.Workshop.ViewModels.WorkshopDetailViewModel>

@{
    ViewData["Title"] = "Dashboard";
}

<div class="text-center">
    <h1 class="display-4">Oficinas</h1>
    <br />
    <br />


    <div class="row">

        @foreach (var item in Model)
        {

            <div class="col-sm-4">
                <div class="card">
                    <div class="card-body">
                        <h3 class="card-title">@item.Name</h3>
                        <p class="card-text">Gestão de lavagens e agendamentos</p>
                        <div class="d-grid gap-2 col-6 mx-auto">
                            <a asp-controller="Workshop" asp-action="Management"
                               asp-route-id="@item.Id"
                               asp-route-name="@item.Name"
                               class="btn btn-primary">Gerir</a>
                        </div>
                    </div>
                </div>
            </div>

        }

    </div>


    <br />
    <br />
    <h1 class="display-4">Gestão</h1>
    <br />
    <br />

    <div class="row">

        @if (User.IsInRole(Roles.Administrator) || User.IsInRole(Roles.DataManager))
        {

            <div class="col-sm-4">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title">Oficinas</h4>
                        <p class="card-text">Gestão de oficinas</p>
                        <div class="d-grid gap-2 col-6 mx-auto">
                            <a asp-controller="Workshop" asp-action="Index" class="btn btn-primary">Gerir</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-4">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title">Viaturas</h4>
                        <p class="card-text">Gestão de viaturas e contratos associados</p>
                        <div class="d-grid gap-2 col-6 mx-auto">
                            <a asp-controller="MechanicalWorkshopVehicle" asp-action="Index" class="btn btn-primary">Gerir</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-4">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title">Administradores</h4>
                        <p class="card-text">Gestão de contratos e administradores</p>
                        <div class="d-grid gap-2 col-6 mx-auto">
                            <a asp-controller="AdminMechanicalWorkShop" asp-action="Index" class="btn btn-primary">Gerir</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>



    <br />


</div>

