@using PortalEquador.Domain.MechanicalWorkshop.Scheduler
@model PortalEquador.Domain.MechanicalWorkshop.Scheduler.ViewModels.DayPlannerViewModel
@using PortalEquador.Util
@using PortalEquador.Util.Constants

@{
    ViewData["Title"] = "Index";
}


<div class="row align-items-center">
    <div class="col-md-10">
        <h1>Oficina @ViewData[ViewBagConstants.WORKSHOP_NAME]</h1>
        <h4>Planificação de trabalhos - Revisão dos veículos da frota</h4>
    </div>
    <div class="col-md-2 text-right">
        <a asp-controller="Workshop" asp-action="Management"
           asp-route-id="@ViewData[ViewBagConstants.WORKSHOP_ID]"
           asp-route-name="@ViewData[ViewBagConstants.WORKSHOP_NAME]"
        class="btn btn-dark"> <i class="fas fa-info-circle" title="Regressar ao Painel"></i> Regressar ao Painel</a>
    </div>
</div>
<hr />
<br />



<div class="row">
    <div class="col-md-12">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <dl class="row">
                <dt class="col-sm-2">
                    <input id="interventionDate" asp-for="MainTime" class="form-control" />
                </dt>
                
                <dd class="col-sm-10">
                    <a href="#" id="searchButton" class="btn btn-info">
                        <i class="fas fa-search" title="Pesquisar"></i>
                    </a>
                </dd>


            </dl>

            <br />
            <br />

            <table class="table">
                <thead>
                    <tr>
                        <th scope="col">Horário</th>
                        
                        @for (int i = 0; i < Model.Mechanics.Count; i++)
                        {
                            var mechanic = Model.Mechanics[i];
                            <th scope="col">
                                Mecânico @(i + 1)
                                @if (!mechanic.Active)
                                {
                                    <span class="badge bg-danger ms-1">Inativo</span>
                                }
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>


                    @foreach (var interventionTime in Model.InterventionTimes)
                    {
                        <tr>
                            <th class="align-middle"><p class="fs-5">@Html.DisplayFor(modelItem => interventionTime.Value.Description)</p></th>

                            @foreach (var appointement in Model.Appointements[interventionTime.Key])
                            {
                                <td>
                                    <div class="card text-center">
                                        <div class="card-body">
                                            @switch (appointement.ScheduleType)
                                            {
                                                case SchedulerType.Free:
                                                    <h5 class="card-title">Sem agendamento</h5>
                                                    <p class="card-text">Horário livre</p>

                                                    <a asp-action="Create" class="btn btn-success" 
                                                        asp-route-date="@Model.MainTime"
                                                       asp-route-workshopid="@ViewData[ViewBagConstants.WORKSHOP_ID]"
                                                       asp-route-workshopname="@ViewData[ViewBagConstants.WORKSHOP_NAME]"
                                                        asp-route-interventionTimeId="@interventionTime.Value.Id" 
                                                        asp-route-mechanicId="@appointement.Mechanic.Id">
                                                        <i class="fas fa-plus"></i> Agendar
                                                    </a>
                                                    break;

                                               case SchedulerType.BlockedFree:
                                                    <h5 class="card-title">Fechado</h5>
                                                    <p class="card-text">Horário não preenchido</p>
                                                    <a href="#" class="btn btn-light">
                                                        <i class="fas fa-solid fa-lock"></i>
                                                    </a>
                                                    break;

                                                case SchedulerType.InactiveMechanic:
                                                    <h5 class="card-title">Inativo</h5>
                                                    <p class="card-text">Horário indisiponível</p>
                                                    <a href="#" class="btn btn-light">
                                                        <i class="fas fa-solid fa-lock"></i>
                                                    </a>
                                                    break;

                                                case SchedulerType.Blocked:
                                                    <h5 class="card-title">Indisponível</h5>
                                                    <p class="card-text">Horário preenchido</p>
                                                    <a href="#" class="btn btn-primary">
                                                        <i class="fa-solid fa-check-double"></i>
                                                    </a>
                                                    break;

                                                case SchedulerType.BlockedDateInThePast:
                                                    <h5 class="card-title">@Html.DisplayFor(modelItem => appointement.Vehicle.LicencePlate)</h5>
                                                    <p class="card-text">Contracto: @Html.DisplayFor(modelItem => appointement.ContractDescription)</p>
                                                    if (appointement.CurrentState == SchedulerState.Open)
                                                    {
                                                        <a asp-action="Details" asp-route-id="@appointement.Id" class="btn btn-info"><i class="fas fa-eye" title="Detalhe"></i></a>
                                                        <a href="#" class="btn btn-light">
                                                            <i class="fas fa-solid fa-lock"></i>
                                                        </a>
                                                        <br />
                                                        <hr />
                                                        <a asp-action="NotPerformed" 
                                                        asp-route-id="@appointement.Id" 
                                                        asp-route-time="@Model.MainTime" 
                                                         asp-route-workshopid="@ViewData[ViewBagConstants.WORKSHOP_ID]"
                                                        asp-route-workshopname="@ViewData[ViewBagConstants.WORKSHOP_NAME]"
                                                        class="btn btn-danger"><i class="fas fa-xmark"></i> Não realizada</a>

                                                        <br /> <br />
                                                        <a asp-action="Confirm"
                                                        asp-route-id="@appointement.Id" 
                                                        asp-route-time="@Model.MainTime" 
                                                         asp-route-workshopid="@ViewData[ViewBagConstants.WORKSHOP_ID]"
                                                        asp-route-workshopname="@ViewData[ViewBagConstants.WORKSHOP_NAME]"
                                                        class="btn btn-success"><i class="fas fa-check"></i> Realizada</a>
                                                    }
                                                    else
                                                    {
                                                        @switch (appointement.CurrentState)
                                                        {
                                                            case SchedulerState.NotPerformed:
                                                                <span class="badge bg-danger">@appointement.StatusDescription</span>
                                                                break;
                                                            case SchedulerState.Performed:
                                                                <span class="badge bg-success">@appointement.StatusDescription</span>
                                                                break;
                                                            default:
                                                                break;
                                                        }
                                                    }
                                                    break;

                                                default:
                                                    <h5 class="card-title">@Html.DisplayFor(modelItem => appointement.Vehicle.LicencePlate)</h5>
                                                    <p class="card-text">Contracto: @Html.DisplayFor(modelItem => appointement.ContractDescription)</p>
                                                    if (appointement.CurrentState == SchedulerState.Open)
                                                    {
                                                        <a asp-action="Details" asp-route-id="@appointement.Id" class="btn btn-info"><i class="fas fa-eye" title="Detalhe"></i></a>
                                                        <a asp-action="Delete" 
                                                        asp-route-id="@appointement.Id" 
                                                        asp-route-time="@Model.MainTime"
                                                         asp-route-workshopid="@ViewData[ViewBagConstants.WORKSHOP_ID]"
                                                           asp-route-workshopname="@ViewData[ViewBagConstants.WORKSHOP_NAME]"
                                                        class="btn btn-danger"><i class="fas fa-trash-can" title="Remover"></i></a>
                                                        <br />
                                                        <hr />
                                                        <a asp-action="NotPerformed" 
                                                        asp-route-id="@appointement.Id" 
                                                        asp-route-time="@Model.MainTime"
                                                           asp-route-workshopid="@ViewData[ViewBagConstants.WORKSHOP_ID]"
                                                           asp-route-workshopname="@ViewData[ViewBagConstants.WORKSHOP_NAME]"
                                                        class="btn btn-danger"><i class="fas fa-xmark"></i> Não realizada</a>

                                                        <br /> <br />
                                                        <a asp-action="Confirm" 
                                                        asp-route-id="@appointement.Id" 
                                                        asp-route-time="@Model.MainTime"
                                                           asp-route-workshopid="@ViewData[ViewBagConstants.WORKSHOP_ID]"
                                                           asp-route-workshopname="@ViewData[ViewBagConstants.WORKSHOP_NAME]"
                                                        class="btn btn-success"><i class="fas fa-check"></i> Realizada</a>
                                                    }
                                                    else
                                                    {
                                                        @switch (appointement.CurrentState)
                                                        {
                                                            case SchedulerState.NotPerformed:
                                                                <span class="badge bg-danger">@appointement.StatusDescription</span>
                                                                break;
                                                            case SchedulerState.Performed:
                                                                <span class="badge bg-success">@appointement.StatusDescription</span>
                                                                break;
                                                            default:
                                                                break;
                                                        }
                                                    }
                                                    break;
                                            }
                                        </div>
                                    </div>

                                </td>
                            }
                        </tr>
                    }

                </tbody>
            </table>
        </form>
    </div>

</div>

@section Scripts{
<script>
    const workshopId = '@ViewData[ViewBagConstants.WORKSHOP_ID]';
    const workshopName = '@Html.Raw(
        System.Web.HttpUtility.JavaScriptStringEncode(
            ViewData[ViewBagConstants.WORKSHOP_NAME]?.ToString()
        )
    )';

    document.getElementById("searchButton").addEventListener("click", function () {
        const selectedTime = document.getElementById("interventionDate").value;

        if (!selectedTime) {
            alert("Please select a time.");
            return;
        }

        const url =
            '@Url.Action("Index")' +
            '?Time=' + encodeURIComponent(selectedTime) +
            '&workshopId=' + encodeURIComponent(workshopId) +
            '&workshopName=' + encodeURIComponent(workshopName);

        window.location.href = url;
    });
</script>
}